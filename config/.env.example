# NMS Agent 运行时配置模板（示例）
# 用途：交给运维/部署，告知需要注入哪些环境变量。
# 注意：本文件不含任何真实密钥，请勿把真实值写进版本库。
#       Docker 镜像中不含此文件，运行容器时通过 -e / --env-file / docker secret 注入。

# ===== LLM（必填）=====
# 大模型 API 密钥（真实值由密钥管理系统提供，切勿入库）
LLM_API_KEY=__REPLACE_WITH_REAL_KEY__
# 模型名，例如 glm-4.5-air
LLM_MODEL=glm-4.5-air
# 采样温度
LLM_TEMPERATURE=0.1
# 请求超时（秒）
LLM_TIMEOUT_SECONDS=120
# 可选：API 基址；不填则使用 SDK 默认值
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== NMS 服务（必填）=====
# NMS 后端基础地址，必须以 http:// 或 https:// 开头
NMS_API_BASE_URL=https://your-nms-host

# ===== 数据库（会话/消息 API 必填）=====
# 线程和聊天接口运行时必须提供；当前启动校验不会主动测试连接或 schema。
# 填写格式如 postgresql://user:pass@host:5432/db
DATABASE_URL=

# ===== StepFun 语音输入/播报（可选）=====
# 未配置时文字对话仍可正常运行，语音按钮会返回服务未配置提示。
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_TTS_MODEL=step-tts-mini
STEPFUN_TTS_VOICE=cixingnansheng
# 可选：粤语 / 四川话 / 日语；留空使用音色默认语言。
STEPFUN_TTS_LANGUAGE=
# 可选：例如 高兴、生气；与 STEPFUN_TTS_LANGUAGE 二选一。
STEPFUN_TTS_EMOTION=
STEPFUN_AUDIO_TIMEOUT_SECONDS=60
# 浏览器 WAV 上传大小上限，需小于 StepFun 100MB 上限。
STEPFUN_ASR_MAX_BYTES=10485760

# ===== 短期记忆上下文窗口 =====
# 发送给模型的业务消息 token 预算（不含系统 Prompt 和模型输出）
CONTEXT_MAX_TOKENS=12000
# 单条业务消息的 token 上限
CONTEXT_MAX_MESSAGE_TOKENS=3000
# 会话滚动摘要的最大 token 数
CONTEXT_SUMMARY_MAX_TOKENS=1200
# 动态上下文达到总预算的该比例时触发压缩
CONTEXT_COMPACTION_TRIGGER_RATIO=0.8
# 压缩后的目标上下文不超过总预算的该比例
CONTEXT_COMPACTION_TARGET_RATIO=0.4
# 压缩后优先保留的最近完整 user -> assistant 对话轮数
CONTEXT_MIN_RECENT_ROUNDS=10

# ===== 长期记忆抽取（第 2、3 块）=====
# 是否在最终 assistant 回复写入后异步抽取候选记忆
LONG_TERM_MEMORY_ENABLED=true
# 可选：抽取使用的模型；留空时复用 LLM_MODEL
LONG_TERM_MEMORY_EXTRACTION_MODEL=
# 抽取模型采样温度和输出/请求上限
LONG_TERM_MEMORY_EXTRACTION_TEMPERATURE=0
LONG_TERM_MEMORY_EXTRACTION_MAX_TOKENS=600
LONG_TERM_MEMORY_EXTRACTION_TIMEOUT_SECONDS=30
# 单轮候选上限、单条记忆长度和入库最低重要度
LONG_TERM_MEMORY_MAX_CANDIDATES=5
LONG_TERM_MEMORY_MAX_CONTENT_LENGTH=240
LONG_TERM_MEMORY_MIN_IMPORTANCE=4
LONG_TERM_MEMORY_MAX_EVIDENCE_MESSAGES=4

# ===== 长期记忆向量索引 =====
# 使用本地 BAAI/bge-base-zh-v1.5 生成长期记忆和检索 Query 的 768 维向量。
LONG_TERM_MEMORY_EMBEDDING_ENABLED=true
LONG_TERM_MEMORY_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
LONG_TERM_MEMORY_EMBEDDING_DIMENSIONS=768
# 可设为 cpu、cuda 或本机支持的其他 Sentence Transformers device。
LONG_TERM_MEMORY_EMBEDDING_DEVICE=cpu
LONG_TERM_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
# 是否在入库前使用向量相似度跳过同属性组的语义重复记忆。
LONG_TERM_MEMORY_SEMANTIC_DEDUP_ENABLED=true
# 语义去重的最大余弦距离；越小表示要求越相似。
LONG_TERM_MEMORY_SEMANTIC_DEDUP_DISTANCE=0.2

# ===== 长期记忆召回调试 =====
# 是否在调用 Agent 前召回长期记忆；当前仅打印结果，不注入模型。
LONG_TERM_MEMORY_RECALL_ENABLED=true
# pgvector 按余弦距离粗排后保留的候选记忆数量。
LONG_TERM_MEMORY_RECALL_CANDIDATE_LIMIT=10
# 综合重排后最多输出的相关长期记忆属性组数量。
LONG_TERM_MEMORY_RECALL_TOP_N=3
# 综合分数低于该值的候选不进入最终输出，范围为 0 到 1。
LONG_TERM_MEMORY_RECALL_MIN_SCORE=0.5
# 综合分数中语义相关度的权重；三项权重之和必须为 1。
LONG_TERM_MEMORY_RECALL_RELEVANCE_WEIGHT=0.5
# 综合分数中记忆重要度的权重；三项权重之和必须为 1。
LONG_TERM_MEMORY_RECALL_IMPORTANCE_WEIGHT=0.3
# 综合分数中最近使用时间的权重；三项权重之和必须为 1。
LONG_TERM_MEMORY_RECALL_RECENCY_WEIGHT=0.2
# profile 记忆的每日时间衰减系数，数值越小衰减越慢。
LONG_TERM_MEMORY_RECALL_PROFILE_DECAY_K=0.001
# preference 记忆的每日时间衰减系数，数值越小衰减越慢。
LONG_TERM_MEMORY_RECALL_PREFERENCE_DECAY_K=0.003
# commitment 记忆的每日时间衰减系数，数值越大衰减越快。
LONG_TERM_MEMORY_RECALL_COMMITMENT_DECAY_K=0.01

# ===== 长期记忆注入 =====
# 是否将召回的长期记忆注入 Agent；关闭时仍保留召回调试输出。
LONG_TERM_MEMORY_INJECTION_ENABLED=true
# 长期记忆独立 token 预算。
LONG_TERM_MEMORY_INJECTION_MAX_TOKENS=512

# ===== 官方 Tokenizer =====
# 本地 Hugging Face tokenizer 后端；更换模型时同步更新名称和可选版本。
LLM_TOKENIZER_BACKEND=huggingface
LLM_TOKENIZER_NAME=zai-org/GLM-4.5-Air
LLM_TOKENIZER_REVISION=
# 仅信任官方模型仓库中的远程 tokenizer 代码。
LLM_TOKENIZER_TRUST_REMOTE_CODE=true
